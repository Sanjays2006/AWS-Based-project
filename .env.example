# ==========================================================================
# Cloud Identity Behavior Fingerprinting System — Environment Template
# --------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. NEVER commit the real
# ".env" to version control. All variables are read by application.yml.
# ==========================================================================

# ===== Database (PostgreSQL) =====
DB_URL=jdbc:postgresql://localhost:5432/cloud_identity_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ===== Server =====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===== JWT =====
# Use a long, random base64 secret (>= 256 bits) in production.
JWT_SECRET=change-me-to-a-long-random-base64-secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ===== AWS Credentials =====
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY blank to use the default
# AWS credential chain instead (profile, or IAM role when deployed on AWS).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=

# ===== AWS SNS (security alert fan-out) =====
AWS_SNS_TOPIC_ARN=

# ===== AWS CloudTrail (event ingestion source) =====
AWS_CLOUDTRAIL_BUCKET=
AWS_CLOUDTRAIL_PREFIX=AWSLogs/

# ===== Schedulers (set true to activate; all off by default) =====
SCHEDULER_CLOUDTRAIL_ENABLED=false
# S3 CloudTrail log-file poller — enable only after AWS creds + bucket are set.
SCHEDULER_S3_ENABLED=false
SCHEDULER_S3_POLL_MS=300000
SCHEDULER_S3_INITIAL_DELAY_MS=60000
SCHEDULER_FINGERPRINT_ENABLED=false
SCHEDULER_REPORT_ENABLED=false
SCHEDULER_BASELINE_ENABLED=false

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
